{
  "name": "mcdiary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "麦麦日记 McDiary — 基于麦当劳 MCP 的消费日历与健康营养记录应用",
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node server/index.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  }
}
